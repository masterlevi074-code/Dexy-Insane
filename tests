RunService.RenderStepped:Connect(function()
    if not Config.FlightEnabled then return end
    pcall(function()
        local char = LocalPlayer.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                for _, obj in ipairs(root:GetChildren()) do
                    if obj:IsA("BodyVelocity") or obj:IsA("LinearVelocity") then
                        local currentVel = obj:IsA("BodyVelocity") and obj.Velocity or obj.VectorVelocity
                        local mag = currentVel.Magnitude
                        if mag > 2 then
                            local isFastFlight = mag > 85
                            local applyMult = 1.0

                            if Config.FlightMode == "Both" then
                                applyMult = isFastFlight and Config.FastMultiplier or Config.NormalMultiplier
                            elseif Config.FlightMode == "FastOnly" and isFastFlight then
                                applyMult = Config.FastMultiplier
                            elseif Config.FlightMode == "NormalOnly" and not isFastFlight then
                                applyMult = Config.NormalMultiplier
                            end

                            if obj:IsA("BodyVelocity") then
                                obj.Velocity = currentVel * applyMult
                            else
                                obj.VectorVelocity = currentVel * applyMult
                            end
                        end
                    end
                end
            end
        end
    end)
end)

