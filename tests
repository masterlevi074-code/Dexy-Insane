-- 1. CONFIGURAÇÕES DO ESP DRAGONBALL
-- ============================================================================
local DBConfig = {
    Enabled = true,
    Highlight = true,
    Names = true,
    Distance = true,
    Lines = false,
    Color = Color3.fromRGB(255, 165, 0) -- Laranja
}

local dbObjects = {}

-- ============================================================================
-- 2. LÓGICA DE FILTRAGEM E CRIAÇÃO DO ESP
-- ============================================================================

-- Verifica se o objeto pertence a um pedestal ou local estático do mapa
local function IsPedestal(obj)
    local current = obj
    while current and current ~= Services.Workspace do
        local nameLower = string.lower(current.Name)
        if nameLower:find("pedestal") or nameLower:find("stand") or nameLower:find("altar") or nameLower:find("spawn") then
            return true
        end
        current = current.Parent
    end
    return false
end

-- Limpa recursos de um objeto específico
local function RemoveESP(obj)
    if dbObjects[obj] then
        if dbObjects[obj].Highlight then dbObjects[obj].Highlight:Destroy() end
        if dbObjects[obj].Billboard then dbObjects[obj].Billboard:Destroy() end
        if dbObjects[obj].Tracer then 
            pcall(function() dbObjects[obj].Tracer:Remove() end)
        end
        dbObjects[obj] = nil
    end
end

-- Limpa todos os elementos do ESP
local function ClearAllESP()
    for obj, _ in pairs(dbObjects) do
        RemoveESP(obj)
    end
end

-- Atualiza ou cria as linhas (Tracers) via Drawing API
local function UpdateTracer(objData, targetPos)
    if not DBConfig.Lines or not DBConfig.Enabled then
        if objData.Tracer then objData.Tracer.Visible = false end
        return
    end

    if not objData.Tracer then
        if Drawing then
            local tracer = Drawing.new("Line")
            tracer.Thickness = 1.5
            tracer.Color = DBConfig.Color
            tracer.Transparency = 1
            objData.Tracer = tracer
        end
    end

    if objData.Tracer then
        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPos)
        if onScreen then
            objData.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
            objData.Tracer.To = Vector2.new(screenPos.X, screenPos.Y)
            objData.Tracer.Visible = true
        else
            objData.Tracer.Visible = false
        end
    end
end

-- Varredura principal do mapa
local function ScanWorkspace()
    if not DBConfig.Enabled then
        ClearAllESP()
        return
    end

    local activeItems = {}
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local mapFolder = Services.Workspace:FindFirstChild("Map") or Services.Workspace

    for _, obj in ipairs(mapFolder:GetDescendants()) do
        if obj:IsA("Model") and obj ~= LocalPlayer.Character then
            if not IsPedestal(obj) then
                local hasStructure = obj:FindFirstChild("Decor") or obj:FindFirstChild("Force") or obj:FindFirstChild("Main")
                
                if hasStructure then
                    activeItems[obj] = true
                    local targetPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart") or obj:FindFirstChild("Main")
                    
                    if targetPart then
                        local dist = hrp and math.floor((hrp.Position - targetPart.Position).Magnitude) or 0
                        
                        if not dbObjects[obj] then
                            dbObjects[obj] = {}
                            
                            -- Highlight (Chams)
                            local highlight = Instance.new("Highlight")
                            highlight.Name = "DBHighlight"
                            highlight.Adornee = obj
                            highlight.FillColor = DBConfig.Color
                            highlight.FillTransparency = 0.4
                            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                            highlight.Parent = obj
                            dbObjects[obj].Highlight = highlight

                            -- Billboard Gui (Texto e Distância)
                            local billboard = Instance.new("BillboardGui")
                            billboard.Name = "DBTextGui"
                            billboard.Size = UDim2.new(0, 140, 0, 40)
                            billboard.StudsOffset = Vector3.new(0, 3, 0)
                            billboard.AlwaysOnTop = true
                            billboard.Adornee = targetPart

                            local label = Instance.new("TextLabel", billboard)
                            label.Size = UDim2.new(1, 0, 1, 0)
                            label.BackgroundTransparency = 1
                            label.TextColor3 = DBConfig.Color
                            label.Font = Enum.Font.GothamBold
                            label.TextSize = 12
                            label.TextStrokeTransparency = 0

                            billboard.Parent = obj
                            dbObjects[obj].Billboard = billboard
                            dbObjects[obj].TextLabel = label
                        end

                        -- Atualiza visibilidade e textos
                        local data = dbObjects[obj]
                        
                        if data.Highlight then
                            data.Highlight.Enabled = DBConfig.Highlight
                        end

                        if data.Billboard and data.TextLabel then
                            data.Billboard.Enabled = DBConfig.Names or DBConfig.Distance
                            
                            local textComponents = {}
                            if DBConfig.Names then table.insert(textComponents, "DragonBall") end
                            if DBConfig.Distance then table.insert(textComponents, "[" .. dist .. "m]") end
                            
                            data.TextLabel.Text = table.concat(textComponents, "\n")
                        end

                        -- Atualiza a Linha
                        UpdateTracer(data, targetPart.Position)
                    end
                end
            end
        end
    end

    -- Limpa itens recolhidos ou destruídos
    for obj, _ in pairs(dbObjects) do
        if not activeItems[obj] or not obj.Parent then
            RemoveESP(obj)
        end
    end
end

