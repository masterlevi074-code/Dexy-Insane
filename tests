	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		if draggingPanel and dragStartPos and startPanelPos then
			local delta = input.Position - dragStartPos
			MainPanel.Position = UDim2.new(
				startPanelPos.X.Scale,
				startPanelPos.X.Offset + delta.X,
				startPanelPos.Y.Scale,
				startPanelPos.Y.Offset + delta.Y
			)
		end

		if resizing and startInputPos and startSize then
			local delta = input.Position - startInputPos
			local newWidth = math.clamp(startSize.X + delta.X, 420, 850)
			local newHeight = math.clamp(startSize.Y + delta.Y, 260, 600)

			MainPanel.Size = UDim2.new(0, newWidth, 0, newHeight)
			lastPanelSize = Vector2.new(newWidth, newHeight)
		end
	end
end)

