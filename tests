    RightCol.Size = UDim2.new(0.5, -5, 1, 0)
    RightCol.Position = UDim2.new(0.5, 5, 0, 0)
    RightCol.BackgroundTransparency = 1
    RightCol.BorderSizePixel = 0
    RightCol.ScrollBarThickness = 3
    local RightLayout = Instance.new("UIListLayout", RightCol)
    RightLayout.Padding = UDim.new(0, 6)

    pages[name] = {Btn = TabBtn, Page = Page, Left = LeftCol, Right = RightCol}

    TabBtn.MouseButton1Click:Connect(function()
        if currentTab == name then return end
        currentTab = name
        for tName, data in pairs(pages) do
            if tName == name then
                data.Btn.TextColor3 = Color3.fromRGB(255, 60, 60)
                data.Page.Visible = true
            else
                data.Btn.TextColor3 = Color3.fromRGB(150, 150, 150)
                data.Page.Visible = false
            end
        end
    end)

    if currentTab == nil then
        TabBtn.TextColor3 = Color3.fromRGB(255, 60, 60)
        Page.Visible = true
        currentTab = name
    end
    return pages[name]
end

local function CreateToggle(parentCol, name, callback)
    local ToggleFrame = Instance.new("Frame", parentCol)
    ToggleFrame.Size = UDim2.new(1, -4, 0, 30)
    ToggleFrame.BackgroundColor3 = Color3.fromRGB(25, 18, 20)
    ToggleFrame.BorderSizePixel = 0
    Instance.new("UICorner", ToggleFrame).CornerRadius = UDim.new(0, 6)

    local TitleLbl = Instance.new("TextLabel", ToggleFrame)
    TitleLbl.Size = UDim2.new(1, -45, 1, 0)
    TitleLbl.Position = UDim2.new(0, 8, 0, 0)
    TitleLbl.BackgroundTransparency = 1
    TitleLbl.Text = name
    TitleLbl.TextColor3 = Color3.fromRGB(220, 220, 220)
    TitleLbl.Font = Enum.Font.GothamSemibold
    TitleLbl.TextSize = 11
    TitleLbl.TextXAlignment = Enum.TextXAlignment.Left

    local ToggleBtn = Instance.new("TextButton", ToggleFrame)
    ToggleBtn.Size = UDim2.new(0, 32, 0, 16)
    ToggleBtn.Position = UDim2.new(1, -38, 0.5, -8)
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 25, 25)
    ToggleBtn.Text = ""
    Instance.new("UICorner", ToggleBtn).CornerRadius = UDim.new(1, 0)

    local Circle = Instance.new("Frame", ToggleBtn)
    Circle.Size = UDim2.new(0, 12, 0, 12)
    Circle.Position = UDim2.new(0, 2, 0.5, -6)
    Circle.BackgroundColor3 = Color3.fromRGB(180, 180, 180)
    Instance.new("UICorner", Circle).CornerRadius = UDim.new(1, 0)

    local isToggled = false
    ToggleBtn.MouseButton1Click:Connect(function()
        isToggled = not isToggled
        if isToggled then
            TweenService:Create(ToggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(255, 40, 40)}):Play()
            TweenService:Create(Circle, TweenInfo.new(0.2), {Position = UDim2.new(0, 18, 0.5, -6), BackgroundColor3 = Color3.fromRGB(255, 255, 255)}):Play()
        else
            TweenService:Create(ToggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 25, 25)}):Play()
            TweenService:Create(Circle, TweenInfo.new(0.2), {Position = UDim2.new(0, 2, 0.5, -6), BackgroundColor3 = Color3.fromRGB(180, 180, 180)}):Play()
        end
        if callback then callback(isToggled) end
    end)
end

