            end
        end)

        OptBtn.MouseButton1Click:Connect(function()
            updateSelected(opt)
            isOpen = false
            TweenService:Create(ArrowLbl, TweenInfo.new(0.2), {Rotation = 0}):Play()
            TweenService:Create(DropdownContainer, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.new(1, -4, 0, baseHeight)}):Play()
            task.delay(0.3, function()
                if not isOpen then ListFrame.Visible = false end
            end)
        end)

        table.insert(optionButtons, OptBtn)
    end

    HeaderBtn.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        if isOpen then
            ListFrame.Visible = true
            TweenService:Create(ArrowLbl, TweenInfo.new(0.2), {Rotation = 180}):Play()
            TweenService:Create(DropdownContainer, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.new(1, -4, 0, 168)}):Play()
