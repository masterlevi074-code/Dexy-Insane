-- ==========================================
-- SISTEMA DE ESP PLAYERS
-- ==========================================
local playerEspObjects = {}
local playerChamsObjects = {}

local function removePlayerESP(player)
    if playerEspObjects[player] then
        for _, obj in pairs(playerEspObjects[player]) do
            pcall(function() obj:Remove() end)
        end
        playerEspObjects[player] = nil
    end
    if playerChamsObjects[player] then
        pcall(function() playerChamsObjects[player]:Destroy() end)
        playerChamsObjects[player] = nil
    end
end

Players.PlayerRemoving:Connect(removePlayerESP)

RunService.RenderStepped:Connect(function()
    if PlayerESPConfig.Enabled and PlayerESPConfig.Chams then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                if not playerChamsObjects[player] then
                    local highlight = Instance.new("Highlight")
                    highlight.Name = "DexyESPChams"
                    highlight.Adornee = player.Character
                    highlight.FillColor = Color3.fromRGB(255, 40, 40)
                    highlight.FillTransparency = 0.5
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.OutlineTransparency = 0
                    highlight.Parent = player.Character
                    playerChamsObjects[player] = highlight
                else
                    if playerChamsObjects[player].Adornee ~= player.Character then
                        playerChamsObjects[player].Adornee = player.Character
                    end
                end
            end
        end
    else
        for player, highlight in pairs(playerChamsObjects) do
            if highlight then highlight:Destroy() end
            playerChamsObjects[player] = nil
        end
    end

    if not PlayerESPConfig.Enabled or not Drawing then
        for player, _ in pairs(playerEspObjects) do
            removePlayerESP(player)
        end
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") then
            local char = player.Character
            local hrp = char.HumanoidRootPart
            local humanoid = char.Humanoid

            if humanoid.Health > 0 then
                if not playerEspObjects[player] then
                    pcall(function()
                        playerEspObjects[player] = {
                            Box = Drawing.new("Square"),
                            Line = Drawing.new("Line"),
                            Name = Drawing.new("Text")
                        }
                        playerEspObjects[player].Box.Visible = false
                        playerEspObjects[player].Box.Thickness = 1.5
                        playerEspObjects[player].Box.Color = Color3.fromRGB(255, 40, 40)
                        playerEspObjects[player].Box.Filled = false

                        playerEspObjects[player].Line.Visible = false
                        playerEspObjects[player].Line.Thickness = 1
                        playerEspObjects[player].Line.Color = Color3.fromRGB(255, 40, 40)

                        playerEspObjects[player].Name.Visible = false
                        playerEspObjects[player].Name.Size = 12
                        playerEspObjects[player].Name.Color = Color3.fromRGB(255, 255, 255)
                        playerEspObjects[player].Name.Center = true
                        playerEspObjects[player].Name.Outline = true
                    end)
                end

                local objs = playerEspObjects[player]
                if objs then
                    local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)

                    if onScreen then
                        local head = char:FindFirstChild("Head")
                        local rootPos = hrp.Position
                        local topPos = head and head.Position + Vector3.new(0, 0.5, 0) or rootPos + Vector3.new(0, 3, 0)
                        local bottomPos = rootPos - Vector3.new(0, 3, 0)

                        local topScreen, topVisible = Camera:WorldToViewportPoint(topPos)
                        local bottomScreen, bottomVisible = Camera:WorldToViewportPoint(bottomPos)

                        if topVisible or bottomVisible then
                            local height = math.abs(topScreen.Y - bottomScreen.Y)
                            local width = height / 2

                            if PlayerESPConfig.Boxes then
                                objs.Box.Visible = true
                                objs.Box.Size = Vector2.new(width, height)
                                objs.Box.Position = Vector2.new(vector.X - width / 2, topScreen.Y)
                            else
                                objs.Box.Visible = false
                            end

                            if PlayerESPConfig.Lines then
                                objs.Line.Visible = true
                                objs.Line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                                objs.Line.To = Vector2.new(vector.X, bottomScreen.Y)
                            else
                                objs.Line.Visible = false
                            end

                            if PlayerESPConfig.Names then
                                objs.Name.Visible = true
                                objs.Name.Text = player.Name
                                objs.Name.Position = Vector2.new(vector.X, topScreen.Y - 16)
                            else
                                objs.Name.Visible = false
                            end
                        else
                            objs.Box.Visible = false
                            objs.Line.Visible = false
                            objs.Name.Visible = false
                        end
                    else
                        objs.Box.Visible = false
                        objs.Line.Visible = false
                        objs.Name.Visible = false
                    end
                end
            else
                removePlayerESP(player)
            end
        else
            removePlayerESP(player)
        end
    end
end)

-- ==========================================
-- SISTEMA DE ESP DRAGONBALL (FILTRO PEDESTAL)
-- ==========================================
local dbObjects = {}

local function IsPedestal(obj)
    local current = obj
    while current and current ~= Workspace do
        local nameLower = string.lower(current.Name)
        if nameLower:find("pedestal") or nameLower:find("stand") or nameLower:find("altar") or nameLower:find("spawn") then
            return true
        end
        current = current.Parent
    end
    return false
end

local function RemoveDBESP(obj)
    if dbObjects[obj] then
        if dbObjects[obj].Highlight then dbObjects[obj].Highlight:Destroy() end
        if dbObjects[obj].Billboard then dbObjects[obj].Billboard:Destroy() end
        if dbObjects[obj].Tracer then 
            pcall(function() dbObjects[obj].Tracer:Remove() end)
        end
        dbObjects[obj] = nil
    end
end

local function ClearAllDBESP()
    for obj, _ in pairs(dbObjects) do
        RemoveDBESP(obj)
    end
end

local function UpdateDBTracer(objData, targetPos)
    if not DBConfig.Lines or not DBConfig.Enabled then
        if objData.Tracer then objData.Tracer.Visible = false end
        return
    end

    if not objData.Tracer and Drawing then
        local tracer = Drawing.new("Line")
        tracer.Thickness = 1.5
        tracer.Color = DBConfig.Color
        tracer.Transparency = 1
        objData.Tracer = tracer
    end

    if objData.Tracer then
        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPos)
        if onScreen then
            objData.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
            objData.Tracer.To = Vector2.new(screenPos.X, screenPos.Y)
            objData.Tracer.Visible = true
        else
            objData.Tracer.Visible = false
        end
    end
end

local function ScanDragonBalls()
    if not DBConfig.Enabled then
        ClearAllDBESP()
        return
    end

    local activeItems = {}
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local mapFolder = Workspace:FindFirstChild("Map") or Workspace

    for _, obj in ipairs(mapFolder:GetDescendants()) do
        if obj:IsA("Model") and obj ~= LocalPlayer.Character then
            if not IsPedestal(obj) then
                local hasStructure = obj:FindFirstChild("Decor") or obj:FindFirstChild("Force") or obj:FindFirstChild("Main")
                
                if hasStructure then
                    activeItems[obj] = true
                    local targetPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart") or obj:FindFirstChild("Main")
                    
                    if targetPart then
                        local dist = hrp and math.floor((hrp.Position - targetPart.Position).Magnitude) or 0
                        
                        if not dbObjects[obj] then
                            dbObjects[obj] = {}
                            
                            local highlight = Instance.new("Highlight")
                            highlight.Name = "DBHighlight"
                            highlight.Adornee = obj
                            highlight.FillColor = DBConfig.Color
                            highlight.FillTransparency = 0.4
                            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                            highlight.Parent = obj
                            dbObjects[obj].Highlight = highlight

                            local billboard = Instance.new("BillboardGui")
                            billboard.Name = "DBTextGui"
                            billboard.Size = UDim2.new(0, 140, 0, 40)
                            billboard.StudsOffset = Vector3.new(0, 3, 0)
                            billboard.AlwaysOnTop = true
                            billboard.Adornee = targetPart

                            local label = Instance.new("TextLabel", billboard)
                            label.Size = UDim2.new(1, 0, 1, 0)
                            label.BackgroundTransparency = 1
                            label.TextColor3 = DBConfig.Color
                            label.Font = Enum.Font.GothamBold
                            label.TextSize = 12
                            label.TextStrokeTransparency = 0

                            billboard.Parent = obj
                            dbObjects[obj].Billboard = billboard
                            dbObjects[obj].TextLabel = label
                        end

                        local data = dbObjects[obj]
                        
                        if data.Highlight then
                            data.Highlight.Enabled = DBConfig.Highlight
                        end

                        if data.Billboard and data.TextLabel then
                            data.Billboard.Enabled = DBConfig.Names or DBConfig.Distance
                            
                            local textComponents = {}
                            if DBConfig.Names then table.insert(textComponents, "DragonBall") end
                            if DBConfig.Distance then table.insert(textComponents, "[" .. dist .. "m]") end
                            
                            data.TextLabel.Text = table.concat(textComponents, "\n")
                        end

                        UpdateDBTracer(data, targetPart.Position)
                    end
                end
            end
        end
    end

    for obj, _ in pairs(dbObjects) do
        if not activeItems[obj] or not obj.Parent then
            RemoveDBESP(obj)
        end
    end
end

task.spawn(function()
    while task.wait(0.3) do
        pcall(ScanDragonBalls)
    end
end)

RunService.RenderStepped:Connect(function()
    if DBConfig.Enabled and DBConfig.Lines then
        for obj, data in pairs(dbObjects) do
            local targetPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart") or obj:FindFirstChild("Main")
            if targetPart then
                UpdateDBTracer(data, targetPart.Position)
            end
        end
    end
end)

