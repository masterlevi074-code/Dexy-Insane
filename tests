local function CreateTab(name, iconType)
    local TabBtn = Instance.new("TextButton", TabsContainer)
    TabBtn.Size = UDim2.new(0, 85, 1, 0)
    TabBtn.BackgroundTransparency = 1
    TabBtn.Text = "" 
    TabBtn.AutoButtonColor = false
    TabBtn.ZIndex = 30

    CreateTabSymbol(TabBtn, iconType)

    local TabText = Instance.new("TextLabel", TabBtn)
    TabText.Size = UDim2.new(1, -34, 1, 0)
    TabText.Position = UDim2.new(0, 34, 0, 0)
    TabText.BackgroundTransparency = 1
    TabText.Text = name
    TabText.TextColor3 = Color3.fromRGB(150, 150, 150)
    TabText.Font = Enum.Font.GothamSemibold
    TabText.TextSize = 12
    TabText.TextXAlignment = Enum.TextXAlignment.Left
    TabText.ZIndex = 30

    local Page = Instance.new("Frame", PagesContainer)
    Page.Size = UDim2.new(1, 0, 1, 0)
    Page.BackgroundTransparency = 1
    Page.Visible = false
    Page.ZIndex = 30

    local LeftCol = Instance.new("ScrollingFrame", Page)
    LeftCol.Size = UDim2.new(0.5, -5, 1, 0)
    LeftCol.Position = UDim2.new(0, 0, 0, 0)
    LeftCol.BackgroundTransparency = 1
    LeftCol.BorderSizePixel = 0
    LeftCol.ScrollBarThickness = 3
    LeftCol.ScrollBarImageColor3 = Color3.fromRGB(200, 40, 40)
    LeftCol.ZIndex = 30
    local LeftLayout = Instance.new("UIListLayout", LeftCol)
    LeftLayout.SortOrder = Enum.SortOrder.LayoutOrder
    LeftLayout.Padding = UDim.new(0, 6)
    LeftLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        LeftCol.CanvasSize = UDim2.new(0, 0, 0, LeftLayout.AbsoluteContentSize.Y + 10)
    end)

    local RightCol = Instance.new("ScrollingFrame", Page)
    RightCol.Size = UDim2.new(0.5, -5, 1, 0)
    RightCol.Position = UDim2.new(0.5, 5, 0, 0)
    RightCol.BackgroundTransparency = 1
    RightCol.BorderSizePixel = 0
    RightCol.ScrollBarThickness = 3
    RightCol.ScrollBarImageColor3 = Color3.fromRGB(200, 40, 40)
    RightCol.ZIndex = 30
    local RightLayout = Instance.new("UIListLayout", RightCol)
    RightLayout.SortOrder = Enum.SortOrder.LayoutOrder
    RightLayout.Padding = UDim.new(0, 6)
    RightLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        RightCol.CanvasSize = UDim2.new(0, 0, 0, RightLayout.AbsoluteContentSize.Y + 10)
    end)

    local CenterDivider = Instance.new("Frame", Page)
    CenterDivider.Size = UDim2.new(0, 1, 1, -5)
    CenterDivider.Position = UDim2.new(0.5, 0, 0, 0)
    CenterDivider.BackgroundColor3 = Color3.fromRGB(255, 40, 40)
    CenterDivider.BackgroundTransparency = 0.7
    CenterDivider.BorderSizePixel = 0

    pages[name] = {Btn = TabBtn, TextLbl = TabText, Page = Page, Left = LeftCol, Right = RightCol}

    TabBtn.MouseButton1Click:Connect(function()
        CreateRipple(TabBtn)
        if currentTab == name or isRolledUp then return end
        currentTab = name
        for tName, data in pairs(pages) do
            if tName == name then
                TweenService:Create(data.TextLbl, TweenInfo.new(0.3), {TextColor3 = Color3.fromRGB(255, 60, 60)}):Play()
                data.Page.Visible = true
            else
                TweenService:Create(data.TextLbl, TweenInfo.new(0.3), {TextColor3 = Color3.fromRGB(150, 150, 150)}):Play()
                data.Page.Visible = false
            end
        end
    end)

    if currentTab == nil then
        TabText.TextColor3 = Color3.fromRGB(255, 60, 60)
        Page.Visible = true
        currentTab = name
    end
    return pages[name]
end

