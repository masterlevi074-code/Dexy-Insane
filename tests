-- AUTO FARM ZENIS LOOP (SUPORTE A MÚLTIPLOS NPCS)
-- ==========================================
local farmKeyE_Down = false
local farmKeyQ_Down = false

local function farmPressKey(keyCode)
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    end)
end

local function farmHoldKey(keyCode)
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
    end)
end

local function farmReleaseKey(keyCode)
    pcall(function()
        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    end)
end

local function farmReleaseAllKeys()
    if farmKeyE_Down then
        farmReleaseKey(Enum.KeyCode.E)
        farmKeyE_Down = false
    end
    if farmKeyQ_Down then
        farmReleaseKey(Enum.KeyCode.Q)
        farmKeyQ_Down = false
    end
end

local function isPlayerGrounded()
    local character = LocalPlayer.Character
    if not character then return false end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        return humanoid.FloorMaterial ~= Enum.Material.Air
    end
    return false
end

local function ensureFlying()
    if isPlayerGrounded() then
        farmPressKey(Enum.KeyCode.Space)
        task.wait(0.08)
        farmPressKey(Enum.KeyCode.Space)
        task.wait(0.2)
    end
end

local function getTargetNPC()
    local npcsFolder = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("NPCs")
    if not npcsFolder then return nil end

    for _, npc in ipairs(npcsFolder:GetChildren()) do
        if Config.SelectedNPCs[npc.Name] then
            local humanoid = npc:FindFirstChildOfClass("Humanoid")
            local rootPart = npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart
            if humanoid and rootPart and humanoid.Health > 0 then
                return npc, humanoid, rootPart
            end
        end
    end
    return nil
end

task.spawn(function()
    local previousTarget = nil

    while true do
        if Config.AutoFarmZenis then
            pcall(function()
                local npc, humanoid, rootPart = getTargetNPC()

                if npc and humanoid and rootPart and humanoid.Health > 0 then
                    local isNewTarget = (npc ~= previousTarget)
                    previousTarget = npc

                    local character = LocalPlayer.Character
                    local myRoot = character and (character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart)

                    if myRoot then
                        myRoot.CFrame = rootPart.CFrame * CFrame.new(0, 0, 3)

                        ensureFlying()

                        if isNewTarget then
                            farmReleaseAllKeys()
                            task.wait(0.1)
                            if Config.SelectedAttackMode == "Ki" or Config.SelectedAttackMode == "Ambos" then
                                farmPressKey(Enum.KeyCode.X)
                                task.wait(0.15)
                            end
                        end

                        if Config.SelectedAttackMode == "Ataque" then
                            if not farmKeyE_Down then
                                farmHoldKey(Enum.KeyCode.E)
                                farmKeyE_Down = true
                            end
                        elseif Config.SelectedAttackMode == "Ki" then
                            if not farmKeyQ_Down then
                                farmHoldKey(Enum.KeyCode.Q)
                                farmKeyQ_Down = true
                            end
                        elseif Config.SelectedAttackMode == "Ambos" then
                            if not farmKeyE_Down then
                                farmHoldKey(Enum.KeyCode.E)
                                farmKeyE_Down = true
                            end
                            if not farmKeyQ_Down then
                                farmHoldKey(Enum.KeyCode.Q)
                                farmKeyQ_Down = true
                            end
                        end
                    end
                else
                    previousTarget = nil
                    farmReleaseAllKeys()
                end
            end)
            task.wait(0.1)
        else
            previousTarget = nil
            farmReleaseAllKeys()
            task.wait(0.3)
        end
    end
end)

