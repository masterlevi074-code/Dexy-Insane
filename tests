-- SISTEMA DE ESP PLAYERS
-- ==========================================
local espObjects = {}
local chamsObjects = {}

local function removeESP(player)
    if espObjects[player] then
        for _, obj in pairs(espObjects[player]) do
            pcall(function() obj:Remove() end)
        end
        espObjects[player] = nil
    end
    if chamsObjects[player] then
        pcall(function() chamsObjects[player]:Destroy() end)
        chamsObjects[player] = nil
    end
end

Players.PlayerRemoving:Connect(removeESP)

RunService.RenderStepped:Connect(function()
    if ESPConfig.Enabled and ESPConfig.Chams then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                if not chamsObjects[player] then
                    local highlight = Instance.new("Highlight")
                    highlight.Name = "DexyESPChams"
                    highlight.Adornee = player.Character
                    highlight.FillColor = ESPConfig.ChamsColor
                    highlight.FillTransparency = 0.5
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.OutlineTransparency = 0
                    highlight.Parent = player.Character
                    chamsObjects[player] = highlight
                else
                    chamsObjects[player].FillColor = ESPConfig.ChamsColor
                    if chamsObjects[player].Adornee ~= player.Character then
                        chamsObjects[player].Adornee = player.Character
                    end
                end
            end
        end
    else
        for player, highlight in pairs(chamsObjects) do
            if highlight then highlight:Destroy() end
            chamsObjects[player] = nil
        end
    end

    if not ESPConfig.Enabled or not Drawing then
        for player, _ in pairs(espObjects) do
            removeESP(player)
        end
        return
    end

    local camera = workspace.CurrentCamera
    if not camera then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") then
            local char = player.Character
            local hrp = char.HumanoidRootPart
            local humanoid = char.Humanoid

            if humanoid.Health > 0 then
                if not espObjects[player] then
                    pcall(function()
                        espObjects[player] = {
                            Box = Drawing.new("Square"),
                            Line = Drawing.new("Line"),
                            Name = Drawing.new("Text"),
                            Distance = Drawing.new("Text")
                        }
                        espObjects[player].Box.Visible = false
                        espObjects[player].Box.Thickness = 1.5
                        espObjects[player].Box.Color = ESPConfig.BoxColor
                        espObjects[player].Box.Filled = false

                        espObjects[player].Line.Visible = false
                        espObjects[player].Line.Thickness = 1
                        espObjects[player].Line.Color = ESPConfig.LineColor

                        espObjects[player].Name.Visible = false
                        espObjects[player].Name.Size = 12
                        espObjects[player].Name.Color = ESPConfig.NameColor
                        espObjects[player].Name.Center = true
                        espObjects[player].Name.Outline = true

                        espObjects[player].Distance.Visible = false
                        espObjects[player].Distance.Size = 11
                        espObjects[player].Distance.Color = ESPConfig.DistanceColor
                        espObjects[player].Distance.Center = true
                        espObjects[player].Distance.Outline = true
                    end)
                end

                local objs = espObjects[player]
                if objs then
                    local vector, onScreen = camera:WorldToViewportPoint(hrp.Position)

                    if onScreen then
                        local head = char:FindFirstChild("Head")
                        local rootPos = hrp.Position
                        local topPos = head and head.Position + Vector3.new(0, 0.5, 0) or rootPos + Vector3.new(0, 3, 0)
                        local bottomPos = rootPos - Vector3.new(0, 3, 0)

                        local topScreen, topVisible = camera:WorldToViewportPoint(topPos)
                        local bottomScreen, bottomVisible = camera:WorldToViewportPoint(bottomPos)

                        if topVisible or bottomVisible then
                            local height = math.abs(topScreen.Y - bottomScreen.Y)
                            local width = height / 2

                            if ESPConfig.Boxes then
                                objs.Box.Visible = true
                                objs.Box.Size = Vector2.new(width, height)
                                objs.Box.Position = Vector2.new(vector.X - width / 2, topScreen.Y)
                                objs.Box.Color = ESPConfig.BoxColor
                            else
                                objs.Box.Visible = false
                            end

                            if ESPConfig.Lines then
                                objs.Line.Visible = true
                                objs.Line.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                                objs.Line.To = Vector2.new(vector.X, bottomScreen.Y)
                                objs.Line.Color = ESPConfig.LineColor
                            else
                                objs.Line.Visible = false
                            end

                            if ESPConfig.Names then
                                objs.Name.Visible = true
                                objs.Name.Text = player.Name
                                objs.Name.Position = Vector2.new(vector.X, topScreen.Y - 16)
                                objs.Name.Color = ESPConfig.NameColor
                            else
                                objs.Name.Visible = false
                            end

                            if ESPConfig.Distance then
                                objs.Distance.Visible = true
                                local dist = math.floor((hrp.Position - camera.CFrame.Position).Magnitude)
                                objs.Distance.Text = "[" .. dist .. "m]"
                                objs.Distance.Position = Vector2.new(vector.X, bottomScreen.Y + 2)
                                objs.Distance.Color = ESPConfig.DistanceColor
                            else
                                objs.Distance.Visible = false
                            end
                        else
                            objs.Box.Visible = false
                            objs.Line.Visible = false
                            objs.Name.Visible = false
                            objs.Distance.Visible = false
                        end
                    else
                        objs.Box.Visible = false
                        objs.Line.Visible = false
                        objs.Name.Visible = false
                        objs.Distance.Visible = false
                    end
                end
            else
                removeESP(player)
            end
        else
            removeESP(player)
        end
    end
end)

