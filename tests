local function IsPedestal(obj)
    local current = obj
    while current and current ~= workspace do
        local nameLower = string.lower(current.Name)
        if nameLower:find("pedestal") or nameLower:find("stand") or nameLower:find("altar") or nameLower:find("display") or nameLower:find("shop") or nameLower:find("spawn") then
            return true
        end
        current = current.Parent
    end
    return false
end

local function GetStarFromTexture(obj)
    local starEmitter = obj:FindFirstChild("StarEmitter", true)
    if starEmitter and (starEmitter:IsA("ParticleEmitter") or starEmitter:IsA("Decal") or starEmitter:IsA("Texture") or starEmitter:IsA("Beam")) then
        local textureUrl = tostring(starEmitter.Texture)
        for id, starNumber in pairs(TEXTURE_MAP) do
            if textureUrl:find(id) then
                return starNumber
            end
        end
    end

    for _, desc in ipairs(obj:GetDescendants()) do
        if (desc:IsA("ParticleEmitter") or desc:IsA("Decal") or desc:IsA("Texture") or desc:IsA("Beam")) and desc.Texture then
            local tex = tostring(desc.Texture)
            for id, starNumber in pairs(TEXTURE_MAP) do
                if tex:find(id) then
                    return starNumber
                end
            end
        end
    end
    return nil
end

local function IsDragonBallObj(obj)
    if not (obj:IsA("Model") or obj:IsA("BasePart")) then return false end
    if obj == LocalPlayer.Character then return false end
    if IsPedestal(obj) then return false end

    local nameLower = string.lower(obj.Name)
    local nameMatch = nameLower:find("dragonball") or nameLower:find("dragon ball") or nameLower:find("db") or nameLower:find("esfera")
    local hasStructure = obj:FindFirstChild("Decor") or obj:FindFirstChild("Force") or obj:FindFirstChild("Main")
    local hasPrompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true) ~= nil

    return (nameMatch or (hasStructure and hasPrompt) or (hasStructure and not IsPedestal(obj)))
end

local function PlayerHasStar(starNumber)
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local character = LocalPlayer.Character
    local containers = {backpack, character}

    for _, container in ipairs(containers) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                local starFromTex = GetStarFromTexture(item)
                if starFromTex == starNumber then
                    return true
                end

                local nameLower = string.lower(item.Name)
                if (nameLower:find("dragon") or nameLower:find("db") or nameLower:find("esfera")) and nameLower:find(tostring(starNumber)) then
                    return true
                end
            end
        end
    end
    return false
end

local function TeleportToObj(targetObj)
    if not targetObj then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    if hrp then
        local targetPart = targetObj:IsA("BasePart") and targetObj 
            or targetObj.PrimaryPart 
            or targetObj:FindFirstChild("Main") 
            or targetObj:FindFirstChildWhichIsA("BasePart")

        if targetPart then
            hrp.CFrame = targetPart.CFrame * CFrame.new(0, 3, 0)
        end
    end
end

