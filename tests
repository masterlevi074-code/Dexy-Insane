-- TELEPORTE PARA DRAGON BALLS
local function TeleportToDragonBallsRoutine()
    if isTeleportingDB then return end
    isTeleportingDB = true

    pcall(function()
        local character = LocalPlayer.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if not hrp then 
            isTeleportingDB = false 
            return 
        end

        local availableDBs = {}
        for obj, _ in pairs(dbObjects) do
            if obj and obj.Parent then
                local targetPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart") or obj:FindFirstChild("Main")
                if targetPart then
                    table.insert(availableDBs, targetPart)
                end
            end
        end

        if #availableDBs > 0 then
            table.sort(availableDBs, function(a, b)
                return (hrp.Position - a.Position).Magnitude < (hrp.Position - b.Position).Magnitude
            end)

            hrp.CFrame = availableDBs[1].CFrame + Vector3.new(0, 3, 0)

            if #availableDBs >= 2 then
                local timer = 0
                while timer < 3.0 do
                    if not Config.AutoTpDB then
                        isTeleportingDB = false
                        return
                    end
                    task.wait(0.1)
                    timer = timer + 0.1
                end

                if not Config.AutoTpDB then
                    isTeleportingDB = false
                    return
                end

                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and availableDBs[2] and availableDBs[2].Parent then
                    LocalPlayer.Character.HumanoidRootPart.CFrame = availableDBs[2].CFrame + Vector3.new(0, 3, 0)
                end
            end
        end
    end)

    isTeleportingDB = false
end

local function AutoGetDragonBallRoutine()
    pcall(function()
        local character = LocalPlayer.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local nearestObj = nil
        local targetPart = nil
        local shortestDist = math.huge

        for obj, _ in pairs(dbObjects) do
            if obj and obj.Parent then
                local part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart") or obj:FindFirstChild("Main")
                if part then
                    local dist = (hrp.Position - part.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        nearestObj = obj
                        targetPart = part
                    end
                end
            end
        end

        if nearestObj and targetPart then
            local originalPos = hrp.CFrame
            
            hrp.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
            task.wait(0.15)
            
            local function triggerPromptRecursive(parent)
                for _, child in ipairs(parent:GetDescendants()) do
                    if child:IsA("ProximityPrompt") then
                        pcall(function()
                            if originalPromptHoldDurations[child] == nil then
                                originalPromptHoldDurations[child] = child.HoldDuration
                            end
                            child.HoldDuration = 0
                            fireproximityprompt(child)
                        end)
                    end
                end
            end
            
            triggerPromptRecursive(nearestObj)
            task.wait(1.0)
            
            if hrp and hrp.Parent then
                hrp.CFrame = originalPos
            end
        end
    end)
end

