local function BuildWindColorPicker(parentFrame, initialColor, onColorChanged)
    local h, s, v = initialColor:ToHSV()

    local pickerContainer = Instance.new("Frame", parentFrame)
    pickerContainer.Size = UDim2.new(1, -16, 0, 130)
    pickerContainer.Position = UDim2.new(0, 8, 0, 0)
