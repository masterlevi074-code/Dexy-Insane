-- AUTO FARM ZENIS
local farmKeyE_Down = false
local farmKeyQ_Down = false
local farmKeyC_Down = false

local function farmPressKey(keyCode)
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    end)
end

local function farmHoldKey(keyCode)
    pcall(function() VirtualInputManager:SendKeyEvent(true, keyCode, false, game) end)
end

local function farmReleaseKey(keyCode)
    pcall(function() VirtualInputManager:SendKeyEvent(false, keyCode, false, game) end)
end

local function farmReleaseAllKeys()
    if farmKeyE_Down then farmReleaseKey(Enum.KeyCode.E) farmKeyE_Down = false end
    if farmKeyQ_Down then farmReleaseKey(Enum.KeyCode.Q) farmKeyQ_Down = false end
    if farmKeyC_Down then farmReleaseKey(Enum.KeyCode.C) farmKeyC_Down = false end
end

local function isPlayerGrounded()
    local character = LocalPlayer.Character
    if not character then return false end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    return humanoid and humanoid.FloorMaterial ~= Enum.Material.Air
end

local function ensureFlying()
    if isPlayerGrounded() then
        farmPressKey(Enum.KeyCode.Space)
        task.wait(0.08)
        farmPressKey(Enum.KeyCode.Space)
        task.wait(0.2)
    end
end

local function getTargetNPC()
    local npcsFolder = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("NPCs")
    if not npcsFolder then return nil end

    for _, npc in ipairs(npcsFolder:GetChildren()) do
        if Config.SelectedNPCs[npc.Name] then
            local humanoid = npc:FindFirstChildOfClass("Humanoid")
            local rootPart = npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart
            if humanoid and rootPart and humanoid.Health > 0 then
                return npc, humanoid, rootPart
            end
        end
    end
    return nil
end

local function getPlayerEnergyPercent()
    local char = workspace:FindFirstChild(LocalPlayer.Name) or LocalPlayer.Character
    if char then
        local state = char:FindFirstChild("State")
        if state then
            local energyVal = state:FindFirstChild("Energy")
            local maxEnergyVal = state:FindFirstChild("MaxEnergy")
            if energyVal and maxEnergyVal and maxEnergyVal.Value > 0 then
                return (energyVal.Value / maxEnergyVal.Value) * 100
            end
        end
    end
    return 100
end

task.spawn(function()
    local previousTarget = nil
    local bothCurrentMode = "Ataque"
    local lastBothSwitch = tick()
    local isChargingFarm = false

    while true do
        if Config.AutoFarmZenis then
            pcall(function()
                local npc, humanoid, rootPart = getTargetNPC()

                if npc and humanoid and rootPart and humanoid.Health > 0 then
                    local isNewTarget = (npc ~= previousTarget)
                    previousTarget = npc

                    local character = LocalPlayer.Character
                    local myRoot = character and (character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart)

                    if myRoot then
                        myRoot.CFrame = rootPart.CFrame * CFrame.new(0, 0, 3)
                        ensureFlying()

                        local energyPct = getPlayerEnergyPercent()
                        local minKiTrigger = Config.AutoFarmKiMin or 10

                        if energyPct <= minKiTrigger or isChargingFarm then
                            if not isChargingFarm then
                                isChargingFarm = true
                                farmReleaseAllKeys()
                                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Q, false, game)
                                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
                                task.wait(0.03)
                                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
                                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
                                task.wait(0.3)
                                farmHoldKey(Enum.KeyCode.C)
                                farmKeyC_Down = true
                            else
                                if energyPct >= 98 then
                                    isChargingFarm = false
                                    farmReleaseKey(Enum.KeyCode.C)
                                    farmKeyC_Down = false
                                    task.wait(0.1)
                                end
                            end
                        else
                            if isNewTarget then
                                farmReleaseAllKeys()
                                task.wait(0.1)
                                if Config.SelectedAttackMode == "Ki" or Config.SelectedAttackMode == "Ambos" then
                                    farmPressKey(Enum.KeyCode.X)
                                    task.wait(0.15)
                                end
                            end

                            if Config.SelectedAttackMode == "Ataque" then
                                if farmKeyQ_Down then farmReleaseKey(Enum.KeyCode.Q) farmKeyQ_Down = false end
                                if not farmKeyE_Down then farmHoldKey(Enum.KeyCode.E) farmKeyE_Down = true end
                            elseif Config.SelectedAttackMode == "Ki" then
                                if farmKeyE_Down then farmReleaseKey(Enum.KeyCode.E) farmKeyE_Down = false end
                                if not farmKeyQ_Down then farmHoldKey(Enum.KeyCode.Q) farmKeyQ_Down = true end
                            elseif Config.SelectedAttackMode == "Ambos" then
                                if tick() - lastBothSwitch >= 3 then
                                    lastBothSwitch = tick()
                                    bothCurrentMode = (bothCurrentMode == "Ataque") and "Ki" or "Ataque"
                                    farmReleaseAllKeys()
                                    task.wait(0.05)
                                    if bothCurrentMode == "Ki" then
                                        farmPressKey(Enum.KeyCode.X)
                                        task.wait(0.1)
                                    end
                                end

                                if bothCurrentMode == "Ataque" then
                                    if farmKeyQ_Down then farmReleaseKey(Enum.KeyCode.Q) farmKeyQ_Down = false end
                                    if not farmKeyE_Down then farmHoldKey(Enum.KeyCode.E) farmKeyE_Down = true end
                                else
                                    if farmKeyE_Down then farmReleaseKey(Enum.KeyCode.E) farmKeyE_Down = false end
                                    if not farmKeyQ_Down then farmHoldKey(Enum.KeyCode.Q) farmKeyQ_Down = true end
                                end
                            end
                        end
                    end
                else
                    previousTarget = nil
                    isChargingFarm = false
                    farmReleaseAllKeys()
                end
            end)
            task.wait(0.1)
        else
            previousTarget = nil
            isChargingFarm = false
            farmReleaseAllKeys()
            task.wait(0.3)
        end
    end
end)

