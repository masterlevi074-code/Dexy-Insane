            TweenService:Create(Circle, TweenInfo.new(0.2), {Position = UDim2.new(0, 2, 0.5, -5), BackgroundColor3 = Color3.fromRGB(180, 180, 180)}):Play()
        end
        if callback then callback(isToggled) end
    end)

    local ConfigBtn = Instance.new("TextButton", ToggleFrame)
