-- ============================================================================
-- 4. LOOPS DE ATUALIZAÇÃO
-- ============================================================================

-- Loop de varredura no Workspace
task.spawn(function()
    while task.wait(0.3) do
        pcall(ScanWorkspace)
    end
end)

-- Loop para atualização suave das Linhas
Services.RunService.RenderStepped:Connect(function()
    if DBConfig.Enabled and DBConfig.Lines then
        for obj, data in pairs(dbObjects) do
            local targetPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart") or obj:FindFirstChild("Main")
            if targetPart then
                UpdateTracer(data, targetPart.Position)
            end
        end
    end
end)
