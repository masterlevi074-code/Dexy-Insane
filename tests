local function CreateTopButton(name, text, posOffset, sizeW, sizeH, hoverColor, textColor, hasBorder, hasRipple, customTextSize)
    local Btn = Instance.new("TextButton", TopBar)
    Btn.Name = name
    Btn.Size = UDim2.new(0, sizeW, 0, sizeH)
    Btn.Position = UDim2.new(1, posOffset, 0.5, -sizeH/2)
    Btn.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
    Btn.BackgroundTransparency = hasBorder and 0 or 1
    Btn.Text = text
    Btn.TextColor3 = textColor
    Btn.Font = Enum.Font.GothamBold
    Btn.TextSize = customTextSize or 16
    Btn.AutoButtonColor = false
    Btn.ZIndex = 30
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)

    if hasBorder then
        local BtnStroke = Instance.new("UIStroke", Btn)
        BtnStroke.Color = Color3.fromRGB(255, 40, 40)
        BtnStroke.Thickness = 1.5
        BtnStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    end

    Btn.MouseEnter:Connect(function() TweenService:Create(Btn, TweenInfo.new(0.2), {BackgroundColor3 = hoverColor}):Play() end)
    Btn.MouseLeave:Connect(function() TweenService:Create(Btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(10, 10, 10)}):Play() end)
    
    if hasRipple then
        Btn.MouseButton1Click:Connect(function() CreateRipple(Btn) end)
    end
    
    return Btn
end

