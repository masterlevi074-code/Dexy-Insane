RunService.RenderStepped:Connect(function()
    if not Config.FlightEnabled then return end

    pcall(function()
        local char = LocalPlayer.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                for _, obj in ipairs(root:GetChildren()) do
                    if obj:IsA("BodyVelocity") then
                        local currentVel = obj.Velocity
                        local mag = currentVel.Magnitude
                        
                        if mag > 2 then
                            local isFastFlight = mag > 85
                            local applyMult = 1.0

                            if Config.FlightMode == "Both" then
                                applyMult = isFastFlight and Config.FastMultiplier or Config.NormalMultiplier
                            elseif Config.FlightMode == "FastOnly" then
                                if isFastFlight then
                                    applyMult = Config.FastMultiplier
                                end
                            elseif Config.FlightMode == "NormalOnly" then
                                if not isFastFlight then
                                    applyMult = Config.NormalMultiplier
                                end
                            end

                            obj.Velocity = currentVel * applyMult
                        end
                    elseif obj:IsA("LinearVelocity") then
                        local currentVel = obj.VectorVelocity
                        local mag = currentVel.Magnitude
                        
                        if mag > 2 then
                            local isFastFlight = mag > 85
                            local applyMult = 1.0

                            if Config.FlightMode == "Both" then
                                applyMult = isFastFlight and Config.FastMultiplier or Config.NormalMultiplier
                            elseif Config.FlightMode == "FastOnly" then
                                if isFastFlight then
                                    applyMult = Config.FastMultiplier
                                end
                            elseif Config.FlightMode == "NormalOnly" then
                                if not isFastFlight then
                                    applyMult = Config.NormalMultiplier
                                end
                            end

                            obj.VectorVelocity = currentVel * applyMult
                        end
                    end
                end
            end
        end
    end)
end)

