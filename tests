local function TeleportToNearestDragonBall()
    pcall(function()
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local nearestObj = nil
        local shortestDist = math.huge

        for obj, _ in pairs(dbObjects) do
            if obj and obj.Parent then
                local targetPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart") or obj:FindFirstChild("Main")
                if targetPart then
                    local dist = (hrp.Position - targetPart.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        nearestObj = targetPart
                    end
                end
            end
        end

        if nearestObj then
            hrp.CFrame = nearestObj.CFrame + Vector3.new(0, 3, 0)
        end
    end)
end

