local function RefreshTracker()
    local currentMapObjects = {}
    local searchContainers = {workspace:FindFirstChild("Map"), workspace}

    for _, container in ipairs(searchContainers) do
        if container then
            for _, obj in ipairs(container:GetDescendants()) do
                if IsDragonBallObj(obj) then
                    local starNum = GetStarFromTexture(obj)
                    if starNum then
                        currentMapObjects[starNum] = obj
                    end
                end
            end
        end
    end

    SpawnedObjects = currentMapObjects
    local totalSpawned = 0

    for star = 1, 7 do
        local targetObj = SpawnedObjects[star]
        local isSpawned = targetObj ~= nil and targetObj.Parent ~= nil
        local hasInInv = PlayerHasStar(star)

        if isSpawned then
            totalSpawned = totalSpawned + 1
            CardUI[star].MapTag.Text = "SPAWN"
            CardUI[star].MapTag.BackgroundColor3 = Color3.fromRGB(35, 140, 65)
            CardUI[star].MapTag.TextColor3 = Color3.fromRGB(255, 255, 255)

            CardUI[star].TpButton.Text = "TP ⚡"
            CardUI[star].TpButton.BackgroundColor3 = Color3.fromRGB(220, 40, 40)
            CardUI[star].TpButton.TextColor3 = Color3.fromRGB(255, 255, 255)
            CardUI[star].TpButton.AutoButtonColor = true
        else
            CardUI[star].MapTag.Text = "NÃO"
            CardUI[star].MapTag.BackgroundColor3 = Color3.fromRGB(35, 20, 20)
            CardUI[star].MapTag.TextColor3 = Color3.fromRGB(170, 110, 110)

            CardUI[star].TpButton.Text = "OFF"
            CardUI[star].TpButton.BackgroundColor3 = Color3.fromRGB(20, 12, 12)
            CardUI[star].TpButton.TextColor3 = Color3.fromRGB(110, 110, 120)
            CardUI[star].TpButton.AutoButtonColor = false
        end

        if hasInInv then
            CardUI[star].InvTag.Text = "POSSUI"
            CardUI[star].InvTag.BackgroundColor3 = Color3.fromRGB(30, 100, 180)
            CardUI[star].InvTag.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            CardUI[star].InvTag.Text = "NÃO"
            CardUI[star].InvTag.BackgroundColor3 = Color3.fromRGB(20, 12, 12)
            CardUI[star].InvTag.TextColor3 = Color3.fromRGB(130, 130, 140)
        end
    end

    if totalSpawned > 0 then
        SummaryLabel.Text = "Esferas Spawnadas: " .. totalSpawned .. " / 7"
        SummaryLabel.TextColor3 = Color3.fromRGB(46, 204, 113)
    else
        SummaryLabel.Text = "Nenhuma esfera no mapa."
        SummaryLabel.TextColor3 = Color3.fromRGB(160, 160, 170)
    end
end

task.spawn(function()
    while DexyUI and DexyUI.Parent do
        RefreshTracker()
        task.wait(1)
    end
end)

