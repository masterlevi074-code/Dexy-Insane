local function GetStarFromTexture(obj)
    local starEmitter = obj:FindFirstChild("StarEmitter", true)
    
    if starEmitter and (starEmitter:IsA("ParticleEmitter") or starEmitter:IsA("Decal") or starEmitter:IsA("Texture") or starEmitter:IsA("Beam")) then
        local textureUrl = tostring(starEmitter.Texture)
        for id, starNumber in pairs(TEXTURE_MAP) do
            if textureUrl:find(id) then return starNumber end
        end
    end

    for _, desc in ipairs(obj:GetDescendants()) do
        if (desc:IsA("ParticleEmitter") or desc:IsA("Decal") or desc:IsA("Texture") or desc:IsA("Beam")) and desc.Texture then
            local tex = tostring(desc.Texture)
            for id, starNumber in pairs(TEXTURE_MAP) do
                if tex:find(id) then return starNumber end
            end
        end
    end
    return nil
end

local function IsDragonBallLogic(obj)
    if not (obj:IsA("Model") or obj:IsA("BasePart")) then return false end
    if obj == LocalPlayer.Character then return false end
    
    local current = obj
    local isPedestal = false
    while current and current ~= workspace do
        local nameLower = string.lower(current.Name)
        if nameLower:find("pedestal") or nameLower:find("stand") or nameLower:find("altar") or nameLower:find("display") or nameLower:find("shop") then
            isPedestal = true
            break
        end
        current = current.Parent
    end
    if isPedestal then return false end

    local nameLower = string.lower(obj.Name)
    local nameMatch = nameLower:find("dragonball") or nameLower:find("dragon ball") or nameLower:find("db") or nameLower:find("esfera")
    local hasStructure = obj:FindFirstChild("Decor") or obj:FindFirstChild("Force") or obj:FindFirstChild("Main")
    local hasPrompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true) ~= nil

    return (nameMatch or (hasStructure and hasPrompt) or (hasStructure and not isPedestal))
end

