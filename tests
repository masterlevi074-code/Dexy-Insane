    local OptionsContainer = Instance.new("Frame", ToggleFrame)
    OptionsContainer.Size = UDim2.new(1, -16, 0, 0)
    OptionsContainer.Position = UDim2.new(0, 8, 0, 26)
    OptionsContainer.BackgroundTransparency = 1
    OptionsContainer.Visible = false
    OptionsContainer.ZIndex = 30

    local optionsLayout = Instance.new("UIListLayout", OptionsContainer)
    optionsLayout.SortOrder = Enum.SortOrder.LayoutOrder
    optionsLayout.Padding = UDim.new(0, 4)

    local function recalculateHeight()
        optionsLayout:ApplyLayout()
        local totalContentY = optionsLayout.AbsoluteContentSize.Y
        OptionsContainer.Size = UDim2.new(1, -16, 0, totalContentY)
        currentHeight = 32 + totalContentY + 8
        TweenService:Create(ToggleFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.new(1, -4, 0, currentHeight)}):Play()
    end

    for _, sub in ipairs(subOptions) do
        local SubRow = Instance.new("Frame", OptionsContainer)
        SubRow.Size = UDim2.new(1, 0, 0, 22)
        SubRow.BackgroundTransparency = 1
        SubRow.ClipsDescendants = true
        SubRow.ZIndex = 30

        local SubLbl = Instance.new("TextLabel", SubRow)
        SubLbl.Size = UDim2.new(1, -90, 0, 20)
        SubLbl.Position = UDim2.new(0, 0, 0, 0)
        SubLbl.BackgroundTransparency = 1
        SubLbl.Text = sub.Name
        SubLbl.TextColor3 = Color3.fromRGB(170, 170, 170)
        SubLbl.Font = Enum.Font.GothamSemibold
        SubLbl.TextSize = 10
        SubLbl.TextXAlignment = Enum.TextXAlignment.Left
        SubLbl.ZIndex = 30

        local SubToggleBtn = Instance.new("TextButton", SubRow)
        SubToggleBtn.Size = UDim2.new(0, 24, 0, 12)
        SubToggleBtn.Position = UDim2.new(1, -24, 0, 4)
        SubToggleBtn.BackgroundColor3 = Color3.fromRGB(25, 15, 15)
        SubToggleBtn.Text = ""
        SubToggleBtn.AutoButtonColor = false
        SubToggleBtn.ZIndex = 30
        Instance.new("UICorner", SubToggleBtn).CornerRadius = UDim.new(1, 0)

        local SubCircle = Instance.new("Frame", SubToggleBtn)
        SubCircle.Size = UDim2.new(0, 8, 0, 8)
        SubCircle.Position = UDim2.new(0, 2, 0.5, -4)
        SubCircle.BackgroundColor3 = Color3.fromRGB(180, 180, 180)
        SubCircle.ZIndex = 31
        Instance.new("UICorner", SubCircle).CornerRadius = UDim.new(1, 0)

        local subToggled = false
        SubToggleBtn.MouseButton1Click:Connect(function()
            subToggled = not subToggled
            if subToggled then
                TweenService:Create(SubToggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(255, 40, 40)}):Play()
                TweenService:Create(SubCircle, TweenInfo.new(0.2), {Position = UDim2.new(0, 14, 0.5, -4), BackgroundColor3 = Color3.fromRGB(255, 255, 255)}):Play()
            else
                TweenService:Create(SubToggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(25, 15, 15)}):Play()
                TweenService:Create(SubCircle, TweenInfo.new(0.2), {Position = UDim2.new(0, 2, 0.5, -4), BackgroundColor3 = Color3.fromRGB(180, 180, 180)}):Play()
            end
            if sub.Callback then sub.Callback(subToggled) end
        end)

        if sub.GetColor and sub.SetColor then
            local SubColorPreview = Instance.new("TextButton", SubRow)
            SubColorPreview.Size = UDim2.new(0, 26, 0, 14)
            SubColorPreview.Position = UDim2.new(1, -56, 0, 3)
            SubColorPreview.BackgroundColor3 = sub.GetColor()
            SubColorPreview.Text = ""
            SubColorPreview.AutoButtonColor = false
            SubColorPreview.ZIndex = 30
            Instance.new("UICorner", SubColorPreview).CornerRadius = UDim.new(0, 4)

            local SubColorStroke = Instance.new("UIStroke", SubColorPreview)
            SubColorStroke.Color = Color3.fromRGB(50, 30, 30)
            SubColorStroke.Thickness = 1

            local pickerOpen = false
            local activePickerWidget = nil

            SubColorPreview.MouseButton1Click:Connect(function()
                pickerOpen = not pickerOpen
                if pickerOpen then
                    if not activePickerWidget then
                        activePickerWidget = BuildWindColorPicker(SubRow, sub.GetColor(), function(newC)
                            sub.SetColor(newC)
                            SubColorPreview.BackgroundColor3 = newC
                        end)
                        activePickerWidget.Position = UDim2.new(0, 0, 0, 24)
                    end
                    activePickerWidget.Visible = true
                    SubRow.Size = UDim2.new(1, 0, 0, 155)
                else
                    if activePickerWidget then activePickerWidget.Visible = false end
                    SubRow.Size = UDim2.new(1, 0, 0, 22)
                end
                task.wait()
                recalculateHeight()
            end)
        end
    end

    local isExpanded = false
    ConfigBtn.MouseButton1Click:Connect(function()
        isExpanded = not isExpanded
        if isExpanded then
            OptionsContainer.Visible = true
            recalculateHeight()
            TweenService:Create(ConfigBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(255, 40, 40), TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
        else
            TweenService:Create(ToggleFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.new(1, -4, 0, baseHeight)}):Play()
            TweenService:Create(ConfigBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(20, 12, 12), TextColor3 = Color3.fromRGB(200, 200, 200)}):Play()
            task.delay(0.3, function()
                if not isExpanded then OptionsContainer.Visible = false end
            end)
        end
    end)
end

