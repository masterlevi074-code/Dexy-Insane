    while task.wait(0.5) do
        pcall(function()
            local statsFolder = LocalPlayer:FindFirstChild("Stats")
            if statsFolder then
                for statName, lbl in pairs(statLabels) do
                    local statVal = statsFolder:FindFirstChild(statName)
                    if statVal then
                        if statName == "DragonBalls" then
                            local rawVal = statVal.Value
                            if type(rawVal) == "number" then
                                lbl.Text = tostring(rawVal)
                            else
                                local strVal = tostring(rawVal)
                                if strVal:find("=") then
                                    local total = 0
                                    for val in strVal:gmatch("=(%d+)") do
                                        total = total + (tonumber(val) or 0)
                                    end
                                    lbl.Text = tostring(total)
                                elseif strVal:find(",") then
                                    local count = 0
                                    for _ in strVal:gmatch("%d+") do
                                        count = count + 1
                                    end
                                    lbl.Text = tostring(count)
                                else
                                    lbl.Text = tostring(tonumber(strVal) or strVal)
                                end
                            end
                        else
                            lbl.Text = tostring(statVal.Value)
                        end
                    else
                        lbl.Text = "0"
                    end
                end
            end
        end)
    end
end)

