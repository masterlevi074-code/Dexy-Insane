                dragging = true
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

        RunService.RenderStepped:Connect(function()
            if dragging and isExpanded then
                local mousePos = UserInputService:GetMouseLocation()
                local pos = math.clamp((mousePos.X - BarBg.AbsolutePosition.X) / BarBg.AbsoluteSize.X, 0, 1)
                local val = math.floor(minVal + ((maxVal - minVal) * pos) + 0.5)
                BarFill.Size = UDim2.new(pos, 0, 1, 0)
                SubValLbl.Text = tostring(val)
                if speedCallback then speedCallback(val) end
            end
        end)
    end
end

