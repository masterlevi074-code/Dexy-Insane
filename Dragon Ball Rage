local function CreateToggle(parentCol, name, callback, hasConfig, minVal, maxVal, defaultVal, speedCallback)
    local baseHeight = 30
    local expandedHeight = 68
    
    local ToggleFrame = Instance.new("Frame", parentCol)
    ToggleFrame.Size = UDim2.new(1, -4, 0, baseHeight)
    ToggleFrame.BackgroundColor3 = Color3.fromRGB(25, 18, 20)
    ToggleFrame.BorderSizePixel = 0
    ToggleFrame.ClipsDescendants = true
    ToggleFrame.ZIndex = 30
    Instance.new("UICorner", ToggleFrame).CornerRadius = UDim.new(0, 6)
    
    local ToggleStroke = Instance.new("UIStroke", ToggleFrame)
    ToggleStroke.Color = Color3.fromRGB(45, 30, 30)
    ToggleStroke.Thickness = 1

    local TitleLbl = Instance.new("TextLabel", ToggleFrame)
    TitleLbl.Size = UDim2.new(1, hasConfig and -75 or -45, 0, 30)
    TitleLbl.Position = UDim2.new(0, 8, 0, 0)
    TitleLbl.BackgroundTransparency = 1
    TitleLbl.Text = name
    TitleLbl.TextColor3 = Color3.fromRGB(220, 220, 220)
    TitleLbl.Font = Enum.Font.GothamSemibold
    TitleLbl.TextSize = 11
    TitleLbl.TextXAlignment = Enum.TextXAlignment.Left
    TitleLbl.ZIndex = 30

    local ToggleBtn = Instance.new("TextButton", ToggleFrame)
    ToggleBtn.Size = UDim2.new(0, 32, 0, 16)
    ToggleBtn.Position = UDim2.new(1, -38, 0, 7)
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 25, 25)
    ToggleBtn.Text = ""
    ToggleBtn.AutoButtonColor = false
    ToggleBtn.ZIndex = 30
    Instance.new("UICorner", ToggleBtn).CornerRadius = UDim.new(1, 0)

    local Circle = Instance.new("Frame", ToggleBtn)
    Circle.Size = UDim2.new(0, 12, 0, 12)
    Circle.Position = UDim2.new(0, 2, 0.5, -6)
    Circle.BackgroundColor3 = Color3.fromRGB(180, 180, 180)
    Circle.ZIndex = 31
    Instance.new("UICorner", Circle).CornerRadius = UDim.new(1, 0)

    local isToggled = false
    ToggleBtn.MouseButton1Click:Connect(function()
        CreateRipple(ToggleFrame)
        isToggled = not isToggled
        if isToggled then
            TweenService:Create(ToggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(255, 40, 40)}):Play()
            TweenService:Create(Circle, TweenInfo.new(0.2), {Position = UDim2.new(0, 18, 0.5, -6), BackgroundColor3 = Color3.fromRGB(255, 255, 255)}):Play()
        else
            TweenService:Create(ToggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 25, 25)}):Play()
            TweenService:Create(Circle, TweenInfo.new(0.2), {Position = UDim2.new(0, 2, 0.5, -6), BackgroundColor3 = Color3.fromRGB(180, 180, 180)}):Play()
        end
        if callback then callback(isToggled) end
    end)

    if hasConfig then
        local ConfigBtn = Instance.new("TextButton", ToggleFrame)
        ConfigBtn.Size = UDim2.new(0, 24, 0, 16)
        ConfigBtn.Position = UDim2.new(1, -66, 0, 7)
        ConfigBtn.BackgroundColor3 = Color3.fromRGB(35, 22, 25)
        ConfigBtn.Text = "⚙"
        ConfigBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
        ConfigBtn.Font = Enum.Font.GothamBold
        ConfigBtn.TextSize = 10
        ConfigBtn.AutoButtonColor = false
        ConfigBtn.ZIndex = 30
        Instance.new("UICorner", ConfigBtn).CornerRadius = UDim.new(0, 4)

        local SliderContainer = Instance.new("Frame", ToggleFrame)
        SliderContainer.Size = UDim2.new(1, -16, 0, 30)
        SliderContainer.Position = UDim2.new(0, 8, 0, 32)
        SliderContainer.BackgroundTransparency = 1
        SliderContainer.Visible = false
        SliderContainer.ZIndex = 30

        local SubValLbl = Instance.new("TextLabel", SliderContainer)
        SubValLbl.Size = UDim2.new(0, 45, 0, 15)
        SubValLbl.Position = UDim2.new(1, -45, 0, 0)
        SubValLbl.BackgroundTransparency = 1
        SubValLbl.Text = tostring(defaultVal) .. "s"
        SubValLbl.TextColor3 = Color3.fromRGB(255, 60, 60)
        SubValLbl.Font = Enum.Font.GothamBold
        SubValLbl.TextSize = 10
        SubValLbl.TextXAlignment = Enum.TextXAlignment.Right
        SubValLbl.ZIndex = 30

        local SubTitleLbl = Instance.new("TextLabel", SliderContainer)
        SubTitleLbl.Size = UDim2.new(1, -50, 0, 15)
        SubTitleLbl.Position = UDim2.new(0, 0, 0, 0)
        SubTitleLbl.BackgroundTransparency = 1
        SubTitleLbl.Text = "Velocidade / Delay"
        SubTitleLbl.TextColor3 = Color3.fromRGB(160, 160, 160)
        SubTitleLbl.Font = Enum.Font.GothamSemibold
        SubTitleLbl.TextSize = 10
        SubTitleLbl.TextXAlignment = Enum.TextXAlignment.Left
        SubTitleLbl.ZIndex = 30

        local BarBg = Instance.new("Frame", SliderContainer)
        BarBg.Size = UDim2.new(1, 0, 0, 5)
        BarBg.Position = UDim2.new(0, 0, 0, 18)
        BarBg.BackgroundColor3 = Color3.fromRGB(40, 25, 25)
        BarBg.BorderSizePixel = 0
        BarBg.ZIndex = 30
        Instance.new("UICorner", BarBg).CornerRadius = UDim.new(1, 0)

        local BarFill = Instance.new("Frame", BarBg)
        BarFill.Size = UDim2.new((defaultVal - minVal)/(maxVal - minVal), 0, 1, 0)
        BarFill.BackgroundColor3 = Color3.fromRGB(255, 40, 40)
        BarFill.BorderSizePixel = 0
        BarFill.ZIndex = 30
        Instance.new("UICorner", BarFill).CornerRadius = UDim.new(1, 0)

        local isExpanded = false
        ConfigBtn.MouseButton1Click:Connect(function()
            isExpanded = not isExpanded
            if isExpanded then
                SliderContainer.Visible = true
                TweenService:Create(ToggleFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.new(1, -4, 0, expandedHeight)}):Play()
                TweenService:Create(ConfigBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(255, 40, 40), TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
            else
                TweenService:Create(ToggleFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.new(1, -4, 0, baseHeight)}):Play()
                TweenService:Create(ConfigBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(35, 22, 25), TextColor3 = Color3.fromRGB(200, 200, 200)}):Play()
                task.delay(0.3, function()
                    if not isExpanded then SliderContainer.Visible = false end
                end)
            end
        end)

        local dragging = false
        BarBg.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

        RunService.RenderStepped:Connect(function()
            if dragging and isExpanded then
                local mousePos = UserInputService:GetMouseLocation()
                local pos = math.clamp((mousePos.X - BarBg.AbsolutePosition.X) / BarBg.AbsoluteSize.X, 0, 1)
                local val = minVal + ((maxVal - minVal) * pos)
                val = math.floor(val * 100 + 0.5) / 100
                BarFill.Size = UDim2.new(pos, 0, 1, 0)
                SubValLbl.Text = tostring(val) .. "s"
                if speedCallback then speedCallback(val) end
            end
        end)
    end
end

local function CreateSlider(parentCol, name, min, max, default, callback)
    local SliderFrame = Instance.new("Frame", parentCol)
