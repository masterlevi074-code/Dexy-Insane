            local tweenIn = TweenService:Create(particle, TweenInfo.new(duration * 0.2), {BackgroundTransparency = 0.5})
            local tweenMove = TweenService:Create(particle, TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
